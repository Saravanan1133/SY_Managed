@Metadata.layer: #CORE
@UI.headerInfo: {
    typeName: 'Booking Supplement',
    typeNamePlural: 'Booking Supplements',
    title: {
        type: #STANDARD,
        label: 'Booking Supplement Details',
        value:'BookingSupplementId'
    },
    description: {
        type: #STANDARD,
        label: 'Booking Suppl.',
        value: 'SupplementId'
    }
}
annotate entity ZMM_C_BOOKSUPPL_APPR_M with
{
  @UI.facet: [{
        id: 'BookingSupplIdent',
        purpose: #STANDARD,
        position: 10,
        label: 'Booking Supplement Details',
        type: #IDENTIFICATION_REFERENCE
    }]
  @UI.identification: [{ position: 1 }]
  TravelId;
  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  BookingId;
  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  BookingSupplementId;
  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  @Consumption.valueHelpDefinition: [{ entity: {
                                           name: '/DMO/I_Supplement',
                                           element: 'SupplementID'
                                       },
                                       additionalBinding: [{ element: 'Price',
                                                             localElement: 'Price' },
                                                            { element: 'CurrencyCode',
                                                              localElement: 'CurrencyCode' } ] }]

  SupplementId;
  @UI.lineItem: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  Price;
  @Consumption.valueHelpDefinition: [{ entity: {
                                      name: 'I_Currency',
                                      element: 'Currency'
                                  } }]
  CurrencyCode;
}